{
  "name": "canvapps-vscode",
  "displayName": "CanvApps - Canvas UI Support",
  "description": "Language support, syntax highlighting, and snippets for CanvApps .cvs Single-File Components",
  "version": "0.1.0",
  "publisher": "canvapps",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Erickgiber/CanvApps"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "canvapps",
    "canvas",
    "cvs",
    "ui-framework",
    "syntax-highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "canvapps",
        "aliases": [
          "CanvApps",
          "canvapps",
          "cvs"
        ],
        "extensions": [
          ".cvs"
        ],
        "icon": {
          "light": "./icons/canvapps-file.svg",
          "dark": "./icons/canvapps-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "canvapps",
        "scopeName": "source.canvapps",
        "path": "./syntaxes/canvapps.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "text.html": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "canvapps",
        "path": "./snippets/canvapps.json"
      }
    ]
  }
}
