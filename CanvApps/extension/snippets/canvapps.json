{
  "CanvApps Component Template": {
    "prefix": "cvs-component",
    "body": [
      "<script lang=\"ts\">",
      "  const ${1:count} = signal(${2:0});",
      "</script>",
      "",
      "<view width=\"100%\" height=\"100%\" flexDirection=\"column\" alignItems=\"center\" justifyContent=\"center\" padding=\"24\">",
      "  <view width=\"500\" backgroundColor=\"#1e293b\" borderRadius=\"16\" padding=\"24\" flexDirection=\"column\" gap=\"16\">",
      "    <text fontSize=\"22\" fontWeight=\"bold\" color=\"#38bdf8\">${3:Title}</text>",
      "    $0",
      "  </view>",
      "</view>"
    ],
    "description": "Create a boilerplate CanvApps Single File Component"
  },
  "Conditional Block": {
    "prefix": "cvs-if",
    "body": [
      "@if (${1:condition}) {",
      "  $0",
      "} else {",
      "  ",
      "}"
    ],
    "description": "Create a reactive @if block"
  },
  "Iteration Block": {
    "prefix": "cvs-each",
    "body": [
      "@each ${1:items.value} as ${2:item}, ${3:index} {",
      "  $0",
      "}"
    ],
    "description": "Create a reactive @each iteration block"
  },
  "View Container": {
    "prefix": "cvs-view",
    "body": [
      "<view width=\"${1:100%}\" backgroundColor=\"${2:#1e293b}\" borderRadius=\"${3:12}\" padding=\"${4:16}\" flexDirection=\"${5|column,row|}\" gap=\"${6:12}\">",
      "  $0",
      "</view>"
    ],
    "description": "Create a UIView container"
  },
  "Text Node": {
    "prefix": "cvs-text",
    "body": [
      "<text fontSize=\"${1:14}\" color=\"${2:#f8fafc}\"${3: fontWeight=\"bold\"}>${4:Text content}</text>"
    ],
    "description": "Create a UIText element"
  },
  "Button Element": {
    "prefix": "cvs-button",
    "body": [
      "<button label=\"${1:Click Me}\" backgroundColor=\"${2:#0284c7}\" hoverBackgroundColor=\"${3:#0369a1}\" @click=\"${4:handleClick}\" />"
    ],
    "description": "Create a UIButton element"
  },
  "Input Element": {
    "prefix": "cvs-input",
    "body": [
      "<input placeholder=\"${1:Enter text...}\" :value=\"${2:textSignal.value}\" @input=\"${3:handleInput}\" />"
    ],
    "description": "Create a UIInput element"
  },
  "Signal Declaration": {
    "prefix": "cvs-signal",
    "body": [
      "const ${1:state} = signal<${2:string}>(${3:''});"
    ],
    "description": "Create a reactive signal"
  },
  "Anchor / Link Element": {
    "prefix": "cvs-anchor",
    "body": [
      "<a href=\"${1:https://example.com}\"${2: target=\"_blank\"} color=\"${3:#1a73e8}\" hoverColor=\"${4:#174ea6}\" underline=\"${5|hover,always,never|}\">${6:Link text}</a>"
    ],
    "description": "Create a UIAnchor / UILink hyperlink element"
  },
  "Link Element (Alias)": {
    "prefix": "cvs-link",
    "body": [
      "<link href=\"${1:/settings}\" color=\"${2:#1a73e8}\" underline=\"${3|hover,always,never|}\">${4:Link text}</link>"
    ],
    "description": "Create a UIAnchor / UILink hyperlink element"
  },
  "Modal Dialog Overlay": {
    "prefix": "cvs-modal",
    "body": [
      "<modal :open=\"${1:isOpen.value}\" backdropBlur=\"${2:12px}\" backdropColor=\"${3:rgba(15, 23, 42, 0.65)}\" @close=\"${4:closeModal}\">",
      "  <view width=\"${5:480}\" backgroundColor=\"${6:#1e293b}\" borderRadius=\"${7:16}\" padding=\"${8:24}\" flexDirection=\"column\" gap=\"${9:16}\">",
      "    <text fontSize=\"20\" fontWeight=\"bold\" color=\"#ffffff\">${10:Modal Title}</text>",
      "    $0",
      "    <button label=\"Close\" backgroundColor=\"#334155\" @click=\"${4:closeModal}\" />",
      "  </view>",
      "</modal>"
    ],
    "description": "Create a UIModal dialog overlay with frosted glass background blur"
  },
  "Scroll View Container": {
    "prefix": "cvs-scroll-view",
    "body": [
      "<scroll-view width=\"${1:100%}\" height=\"${2:400}\" scroll=\"${3|vertical,horizontal,both|}\" showScrollbar=\"${4|auto,always,never|}\">",
      "  $0",
      "</scroll-view>"
    ],
    "description": "Create a UIScrollView hardware-accelerated scroll container"
  },
  "Image Element": {
    "prefix": "cvs-image",
    "body": [
      "<image src=\"${1:https://example.com/image.png}\" width=\"${2:100%}\" height=\"${3:200}\" fit=\"${4|cover,contain,fill,none|}\" borderRadius=\"${5:12}\" />"
    ],
    "description": "Create a UIImage element"
  },
  "Motion Wrapper": {
    "prefix": "cvs-motion",
    "body": [
      "<motion animation=\"${1|fade,scale-in,slide-up,zoom-center|}\" duration=\"${2:300}\">",
      "  $0",
      "</motion>"
    ],
    "description": "Create a UIMotion GPU-timed animated wrapper"
  },
  "Topnav Header with Safe Area": {
    "prefix": "cvs-topnav",
    "body": [
      "<view width=\"100%\" safeArea=\"top\" flexDirection=\"row\" alignItems=\"center\" justifyContent=\"space-between\" padding=\"[12, 20]\" :backgroundColor=\"${1:isDark.value ? '#181818' : '#ffffff'}\" borderRadius=\"14\">",
      "  <text fontSize=\"18\" fontWeight=\"bold\" color=\"${2:#ffffff}\">${3:🎨 CanvApps}</text>",
      "  <button label=\"Menu\" @click=\"${4:toggleMenu}\" />",
      "</view>"
    ],
    "description": "Create a Topnav header with automatic Notch, Status Bar, and Titlebar Safe Area insets"
  }
}



