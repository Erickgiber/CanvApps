{
  "name": "@canvapps/core",
  "version": "0.1.6",
  "description": "High-performance 100% Canvas-based UI Framework for SPA, PWA, and Native Mobile via Capacitor",
  "type": "module",
  "main": "./dist/canvapps.cjs",
  "module": "./dist/canvapps.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/canvapps.umd.cjs",
  "jsdelivr": "./dist/canvapps.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/canvapps.js",
      "require": "./dist/canvapps.cjs"
    },
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    },
    "./compiler": {
      "types": "./dist/types/compiler/index.d.ts",
      "import": "./dist/compiler/index.js",
      "require": "./dist/compiler/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "bin": {
    "canvapps": "dist/cli/bin.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && npm run build:app",
    "build:packages": "tsx scripts/build-packages.ts",
    "build:app": "tsx CanvApps/cli/bin.ts build",
    "preview": "vite preview --outDir dist-app",
    "prepublishOnly": "npm run build:packages",
    "package:extension": "tsx CanvApps/extension/package-vsix.ts",
    "publish:core": "npm publish --access public",
    "publish:plugin": "cd packages/vite-plugin-canvapps && npm publish --access public",
    "publish:all": "npm run build:packages && npm run publish:core && npm run publish:plugin"
  },
  "keywords": [
    "canvas",
    "ui-framework",
    "graphics-engine",
    "typescript",
    "pwa",
    "capacitor",
    "canvas-ui",
    "vite-plugin",
    "signals",
    "declarative-ui",
    "svelte-like",
    "cvs"
  ],
  "author": "Erickgiber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erickgiber/CanvApps.git"
  },
  "bugs": {
    "url": "https://github.com/Erickgiber/CanvApps/issues"
  },
  "homepage": "https://github.com/Erickgiber/CanvApps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0 || >=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}