{
  "name": "@canvapps/vite-plugin",
  "version": "0.1.3",
  "description": "Official Vite plugin for compiling CanvApps declarative .cvs Canvas UI components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "canvapps",
    "canvas",
    "ui-framework",
    "cvs",
    "sfc",
    "hmr"
  ],
  "author": "Erickgiber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erickgiber/CanvApps.git",
    "directory": "packages/vite-plugin-canvapps"
  },
  "bugs": {
    "url": "https://github.com/Erickgiber/CanvApps/issues"
  },
  "homepage": "https://github.com/Erickgiber/CanvApps#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@canvapps/core": "^0.1.0",
    "vite": ">=5.0.0 || >=6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}