<script lang="ts">
  import HomeView from './views/HomeView.cvs';
  import DocsView from './views/DocsView.cvs';
  import ShowcaseView from './views/ShowcaseView.cvs';
  import GalleryView from './views/GalleryView.cvs';
  import GalleryDetailView from './views/GalleryDetailView.cvs';
  import MusicPlayerView from './views/MusicPlayerView.cvs';
  import NotFoundView from './views/NotFoundView.cvs';
  import AppLayout from './layouts/AppLayout.cvs';
  import { sessionStore, currentRoute, navigateRoute } from './stores/session.store';

  function handleNavigate(target: string) {
    navigateRoute(target);
  }
</script>

<view
  width="100%"
  height="100%"
  :backgroundColor={sessionStore.state.theme === 'dark' ? '#080c14' : '#f8fafc'}
  position="relative"
>

  <!-- Master Application Persistent Layout (Direct Fluid Start) -->
  <AppLayout @navigate="handleNavigate">

    <!-- Home / Framework Presentation Landing Page -->
    @if (currentRoute.value === '/') {
      <HomeView />
    }

    <!-- Interactive Documentation & Component Sandbox -->
    @if (currentRoute.value === '/docs') {
      <DocsView />
    }

    <!-- Showcases Catalog Hub -->
    @if (currentRoute.value === '/showcases') {
      <ShowcaseView />
    }

    <!-- Independent Showcase App: Retina Photo Gallery (/showcases/gallery) -->
    @if (currentRoute.value === '/showcases/gallery' || currentRoute.value === '/gallery') {
      <GalleryView />
    }

    @if (currentRoute.value.startsWith('/showcases/gallery/') || currentRoute.value.startsWith('/gallery/')) {
      <GalleryDetailView />
    }

    <!-- Independent Showcase App: Web Audio Music Studio (/showcases/music) -->
    @if (currentRoute.value === '/showcases/music' || currentRoute.value === '/music' || currentRoute.value.startsWith('/showcases/music') || currentRoute.value.startsWith('/music')) {
      <MusicPlayerView />
    }

    <!-- 404 Fallback Scene for unmapped routes -->
    @if (currentRoute.value !== '/' && currentRoute.value !== '/docs' && currentRoute.value !== '/showcases' && currentRoute.value !== '/showcases/gallery' && currentRoute.value !== '/gallery' && !currentRoute.value.startsWith('/showcases/gallery/') && !currentRoute.value.startsWith('/gallery/') && currentRoute.value !== '/showcases/music' && currentRoute.value !== '/music' && !currentRoute.value.startsWith('/showcases/music') && !currentRoute.value.startsWith('/music')) {
      <NotFoundView />
    }
  </AppLayout>

</view>
