<script lang="ts">
  import SplashView from './views/SplashView.cvs';
  import DashboardView from './views/DashboardView.cvs';
  import GalleryView from './views/GalleryView.cvs';
  import GalleryDetailView from './views/GalleryDetailView.cvs';
  import MusicPlayerView from './views/MusicPlayerView.cvs';
  import NotFoundView from './views/NotFoundView.cvs';
  import AppLayout from './layouts/AppLayout.cvs';
  import { signal } from '@canvapps';
  import { sessionStore, navigateRoute } from './stores/session.store';

  const isSplashActive = signal(true);

  function onSplashFinish() {
    isSplashActive.value = false;
  }

  function handleNavigate(target: string) {
    navigateRoute(target);
  }
</script>

<view width="100%" height="100%" backgroundColor="#101010" position="relative">

  <!-- 1. Master Application Persistent Layout (Contains Header, Slot & Footer) -->
  @if (!isSplashActive.value) {
    <AppLayout @navigate="handleNavigate">
      
      <!-- Strict Canonical Scenes rendered inside AppLayout slot based on activeRoute -->
      @if (sessionStore.state.activeRoute === '/') {
        <DashboardView />
      }

      @if (sessionStore.state.activeRoute === '/gallery') {
        <GalleryView />
      }

      @if (sessionStore.state.activeRoute.startsWith('/gallery/')) {
        <GalleryDetailView />
      }

      @if (sessionStore.state.activeRoute === '/music' || sessionStore.state.activeRoute.startsWith('/music')) {
        <MusicPlayerView />
      }

      <!-- 404 Fallback Scene for unmapped routes -->
      @if (sessionStore.state.activeRoute !== '/' && sessionStore.state.activeRoute !== '/gallery' && !sessionStore.state.activeRoute.startsWith('/gallery/') && sessionStore.state.activeRoute !== '/music' && !sessionStore.state.activeRoute.startsWith('/music')) {
        <NotFoundView />
      }
    </AppLayout>

  } else {
    <!-- 2. Cinematic Intro Splash Screen (Full-Screen Overlay) -->
    <view width="100%" height="100%" position="absolute" left="0" top="0">
      <SplashView @finish="onSplashFinish" />
    </view>
  }
</view>