<script lang="ts">
  import SplashView from './views/SplashView.cvs';
  import DashboardView from './views/DashboardView.cvs';

  // 1. Reactive Navigation State
  const isSplashActive = signal(true);

  // 2. Transition Callback from Splash
  function onSplashFinish() {
    isSplashActive.value = false;
  }
</script>

<view width="100%" height="100%" backgroundColor="#090d16" position="relative">

  <!-- 1. Main Interactive Dashboard View (Animates in smoothly with enter="scale") -->
  @if (!isSplashActive.value) {
    <DashboardView />
  }

  <!-- 2. Cinematic Intro Splash Screen (Full-Screen Overlay) -->
  <view width="100%" height="100%" position="absolute" left="0" top="0" @if="isSplashActive.value">
    <SplashView @finish="onSplashFinish" />
  </view>

</view>
