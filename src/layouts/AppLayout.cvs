<script lang="ts">
  import Breadcrumb from '../components/Breadcrumb.cvs';
  import { sessionStore, currentRoute, toggleTheme, toggleGlobalSound } from '../stores/session.store';

  // Responsive signals
  const { isMobile } = useBreakpoints();
  const isDark = computed(() => sessionStore.state.theme === 'dark');
  const isSoundOn = computed(() => sessionStore.state.isSoundEnabled);

  function handleThemeToggle() {
    toggleTheme();
  }

  function handleSoundToggle() {
    toggleGlobalSound();
  }
</script>

<!-- Application Master Layout with Universal Breadcrumb Header -->
<view
  id="app-layout-scroll"
  width="100%"
  height="100%"
  flexDirection="column"
  overflow="auto"
  safeArea="top"
  :backgroundColor={isDark.value ? '#080c14' : '#f8fafc'}
  :padding={isMobile.value ? [6, 6] : [10, 16]}
  gap="6"
  alignItems="center"
>
  <!-- Universal Breadcrumb Header for all routes-->
  <Breadcrumb />

  <!-- Dynamic View Content Area -->
  <slot />
</view>
