<script lang="ts">
  import AppHeader from '../components/AppHeader.cvs';
  import { sessionStore } from '../stores/session.store';

  // Responsive signals
  const { isMobile } = useBreakpoints();
  const isDark = computed(() => sessionStore.state.theme === 'dark');

  function onHeaderNavigate(target: string) {
    if (typeof (props as any)?.onNavigate === 'function') {
      (props as any).onNavigate(target);
    }
  }
</script>

<!-- Persistent Application Master Layout -->
<view width="100%" height="100%" flexDirection="column" overflow="auto" :backgroundColor={isDark.value ? '#101010' : '#f8fafc'} :padding={isMobile.value ? [8, 10] : [14, 20]} :gap={isMobile.value ? 8 : 12}>

  <!-- 1. Persistent Top Header -->
  <AppHeader :activeRoute="(props as any)?.activeRoute" @navigate="onHeaderNavigate" flexShrink="0" />

  <!-- 2. Dynamic View Content Area -->
  <slot />
</view>
