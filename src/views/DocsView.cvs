          >
            <view
              :width={isMobile.value ? '100%' : '58%'}
              flexDirection="column"
              gap="6"
            >
              <view
                flexDirection="row"
                alignItems="center"
                gap="8"
              >
                <view
                  padding="[3, 8]"
                  backgroundColor="rgba(234, 88, 12, 0.15)"
                  borderRadius="6"
                >
                  <text
                    fontSize="12"
                    fontWeight="bold"
                    color="#ea580c"
                  >
                    &lt;image /&gt;
                  </text>
                </view>
                <text
                  fontSize="15"
                  fontWeight="bold"
                  :color={isDark.value ? '#f1f5f9' : '#0f172a'}
                >
                  Imagen Vectorial y Raster (image)
                </text>
              </view>
              <text
                fontSize="12"
                :color={isDark.value ? '#94a3b8' : '#64748b'}
                lineHeight="1.4"
              >
                {{ t.value.docs.components.imageDesc }}
              </text>
              <text fontSize="11" color="#64748b">
                &lt;image src="/logo.svg" width="32" height="32" /&gt;
              </text>
            </view>

            <!-- Visual Node Demo -->
            <view
              :width={isMobile.value ? '100%' : '42%'}
              padding="[10, 12]"
              :backgroundColor={isDark.value ? '#080c14' : '#ffffff'}
              borderRadius="10"
              borderWidth="1"
              :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
              flexDirection="row"
              gap="10"
              alignItems="center"
              justifyContent="center"
            >
              <image
                src="/logo.svg"
                width="36"
                height="36"
              />
              <text
                fontSize="12"
                fontWeight="bold"
                :color={isDark.value ? '#f1f5f9' : '#0f172a'}
              >
                Logo Vectorial SVG
              </text>
            </view>
          </view>

        </view>
      </view>
    }

    <!-- ========================================================================= -->
    <!-- TAB 3: ATRIBUTOS & PROPS (Directivas, Modificadores y Capacidades Únicas)   -->
    <!-- ========================================================================= -->
    @if (activeTab.value === 'attributes') {
      <view
        width="100%"
        maxWidth="1120"
        flexDirection="column"
        :padding={isMobile.value ? [16, 14] : [24, 28]}
        :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
        borderRadius="18"
        borderWidth="1"
        :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
        gap="18"
        flexShrink="0"
      >
        <view flexDirection="column" gap="4">
          <text
            fontSize="18"
            fontWeight="bold"
            :color={isDark.value ? '#38bdf8' : '#0284c7'}
          >
            {{ t.value.docs.attributes.title }}
          </text>
          <text
            fontSize="13"
            :color={isDark.value ? '#94a3b8' : '#475569'}
            lineHeight="1.5"
          >
            {{ t.value.docs.attributes.subtitle }}
          </text>
        </view>

        <!-- Prop 1: selectable="true" (Ghost DOM Text Selection) -->
        <view
          width="100%"
          flexDirection="column"
          padding="[16, 16]"
          :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
          borderRadius="12"
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#cbd5e1'}
          gap="10"
        >
          <view
            flexDirection="row"
            alignItems="center"
            gap="8"
          >
            <view
              padding="[3, 8]"
              backgroundColor="rgba(56, 189, 248, 0.15)"
              borderRadius="6"
            >
              <text
                fontSize="12"
                fontWeight="bold"
                :color={isDark.value ? '#38bdf8' : '#0284c7'}
              >
                selectable="true"
              </text>
            </view>
            <text
              fontSize="14"
              fontWeight="bold"
              :color={isDark.value ? '#f1f5f9' : '#0f172a'}
            >
              Capa de Selección y Accesibilidad Ghost DOM
            </text>
          </view>
          <text
            fontSize="12"
            :color={isDark.value ? '#94a3b8' : '#64748b'}
            lineHeight="1.4"
          >
            Al aplicar este atributo a cualquier elemento de texto, CanvApps genera automáticamente un nodo accesible invisible en Ghost DOM que sincroniza las coordenadas del canvas, permitiendo resaltar con ratón y copiar al portapapeles (Cmd+C / Ctrl+C).
          </text>
          <view
            padding="[10, 12]"
            :backgroundColor={isDark.value ? '#080c14' : '#ffffff'}
            borderRadius="8"
            borderWidth="1"
            :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
          >
            <text
              :selectable="true"
              fontSize="13"
              fontWeight="bold"
              :color={isDark.value ? '#38bdf8' : '#0284c7'}
            >
              Prueba seleccionarme: Este texto cuenta con selectable="true" y es totalmente copiable.
            </text>
          </view>
        </view>

        <!-- Prop 2: :blur="true" en Modales y Capas -->
        <view
          width="100%"
          flexDirection="column"
          padding="[16, 16]"
          :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
          borderRadius="12"
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#cbd5e1'}
          gap="10"
        >
          <view
            flexDirection="row"
            alignItems="center"
            gap="8"
          >
            <view
              padding="[3, 8]"
              backgroundColor="rgba(168, 85, 247, 0.15)"
              borderRadius="6"
            >
              <text
                fontSize="12"
                fontWeight="bold"
                :color={isDark.value ? '#c084fc' : '#9333ea'}
              >
                :blur="true"
              </text>
            </view>
            <text
              fontSize="14"
              fontWeight="bold"
              :color={isDark.value ? '#f1f5f9' : '#0f172a'}
            >
              Desenfoque Gaussiano Directo en Canvas (Glassmorphism)
            </text>
          </view>
          <text
            fontSize="12"
            :color={isDark.value ? '#94a3b8' : '#64748b'}
            lineHeight="1.4"
          >
            Activa el paso de filtrado shader en el buffer de dibujo del canvas para producir un efecto de cristal translúcido detrás de capas modales sin ralentizar los 120 FPS.
          </text>
          <button
            label="🪟 Probar Efecto :blur=true en Vivo"
            backgroundColor="#0284c7"
            hoverBackgroundColor="#0369a1"
            labelColor="#ffffff"
            borderRadius="8"
            padding="[10, 16]"
            fontSize="13"
            fontWeight="bold"
            @click="openDocModal"
          />
        </view>

        <!-- Prop 3: :binding={signal} Enlace Reactivo -->
        <view
          width="100%"
          flexDirection="column"
          padding="[16, 16]"
          :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
          borderRadius="12"
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#cbd5e1'}
          gap="10"
        >
          <view
            flexDirection="row"
            alignItems="center"
            gap="8"
          >
            <view
              padding="[3, 8]"
              backgroundColor="rgba(34, 197, 94, 0.15)"
              borderRadius="6"
            >
              <text
                fontSize="12"
                fontWeight="bold"
                color="#22c55e"
              >
                :prop="expresión"
              </text>
            </view>
            <text
              fontSize="14"
              fontWeight="bold"
              :color={isDark.value ? '#f1f5f9' : '#0f172a'}
            >
              Directiva de Reactividad Unidireccional
            </text>
          </view>
          <text
            fontSize="12"
            :color={isDark.value ? '#94a3b8' : '#64748b'}
            lineHeight="1.4"
          >
            El prefijo dos puntos (:) indica al compilador que la propiedad depende de un Signal y debe registrar un efecto reactivo de memoria directa para actualizar únicamente esa propiedad en microsegundos.
          </text>
          <view
            flexDirection="row"
            alignItems="center"
            gap="10"
          >
            <button
              label="+1 Incrementar Signal"
              backgroundColor="#16a34a"
              hoverBackgroundColor="#15803d"
              labelColor="#ffffff"
              borderRadius="8"
              padding="[8, 16]"
              fontSize="12"
              fontWeight="bold"
              @click="incrementDemo"
            />
            <text
              fontSize="13"
              fontWeight="bold"
              :color={isDark.value ? '#f1f5f9' : '#0f172a'}
            >
              Valor del Signal: {{ demoCounter.value }}
            </text>
          </view>
        </view>

      </view>
    }

    <!-- ========================================================================= -->
    <!-- TAB 4: LAYOUT & BOX MODEL                                                 -->
    <!-- ========================================================================= -->
    @if (activeTab.value === 'layout') {
      <view
        width="100%"
        maxWidth="1120"
        flexDirection="column"
        :padding={isMobile.value ? [16, 14] : [24, 28]}
        :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
        borderRadius="18"
        borderWidth="1"
        :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
        gap="18"
        flexShrink="0"
      >
        <view flexDirection="column" gap="4">
          <text
            fontSize="18"
            fontWeight="bold"
            :color={isDark.value ? '#38bdf8' : '#0284c7'}
          >
            {{ t.value.docs.layout.title }}
          </text>
          <text
            fontSize="13"
            :color={isDark.value ? '#94a3b8' : '#475569'}
            lineHeight="1.5"
          >
            {{ t.value.docs.layout.subtitle }}
          </text>
        </view>

        <view
          width="100%"
          flexDirection="column"
          gap="12"
        >

          <view
            padding="[12, 16]"
            :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
            borderRadius="10"
            borderWidth="1"
            :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
            flexDirection="column"
            gap="4"
          >
            <text
              fontSize="14"
              fontWeight="bold"
              :color={isDark.value ? '#38bdf8' : '#0284c7'}
            >
              {{ t.value.docs.layout.boxModelTitle }}
            </text>
            <text
              fontSize="12"
              :color={isDark.value ? '#94a3b8' : '#64748b'}
              lineHeight="1.4"
            >
              {{ t.value.docs.layout.boxModelDesc }}
            </text>
          </view>

          <view
            padding="[12, 16]"
            :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
            borderRadius="10"
            borderWidth="1"
            :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
            flexDirection="column"
            gap="4"
          >
            <text
              fontSize="14"
              fontWeight="bold"
              :color={isDark.value ? '#38bdf8' : '#0284c7'}
            >
              {{ t.value.docs.layout.responsiveTitle }}
            </text>
            <text
              fontSize="12"
              :color={isDark.value ? '#94a3b8' : '#64748b'}
              lineHeight="1.4"
            >
              {{ t.value.docs.layout.responsiveDesc }}
            </text>
          </view>

          <view
            padding="[12, 16]"
            :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
            borderRadius="10"
            borderWidth="1"
            :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
            flexDirection="column"
            gap="4"
          >
            <text
              fontSize="14"
              fontWeight="bold"
              :color={isDark.value ? '#38bdf8' : '#0284c7'}
            >
              {{ t.value.docs.layout.flexDirectionTitle }}
            </text>
            <text
              fontSize="12"
              :color={isDark.value ? '#94a3b8' : '#64748b'}
              lineHeight="1.4"
            >
              {{ t.value.docs.layout.flexDirectionDesc }}
            </text>
          </view>

        </view>
      </view>
    }

    <!-- ========================================================================= -->
    <!-- TAB 5: SIGNALS REACTIVITY                                                 -->
    <!-- ========================================================================= -->
    @if (activeTab.value === 'signals') {
      <view
        width="100%"
        maxWidth="1120"
        flexDirection="column"
        :padding={isMobile.value ? [16, 14] : [24, 28]}
        :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
        borderRadius="18"
        borderWidth="1"
        :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
        gap="18"
        flexShrink="0"
      >
        <view flexDirection="column" gap="4">
          <text
            fontSize="18"
            fontWeight="bold"
            :color={isDark.value ? '#38bdf8' : '#0284c7'}
          >
            {{ t.value.docs.signals.title }}
          </text>
          <text
            fontSize="13"
            :color={isDark.value ? '#94a3b8' : '#475569'}
            lineHeight="1.5"
          >
            {{ t.value.docs.signals.subtitle }}
          </text>
        </view>

        <!-- Code Block -->
        <view
          flexDirection="column"
          padding="[16, 18]"
          :backgroundColor={isDark.value ? '#080c14' : '#0f172a'}
          borderRadius="12"
          borderWidth="1"
          borderColor="#1e293b"
          gap="8"
        >
          <text fontSize="12" color="#38bdf8">
            import { signal, computed, effect, batch } from '@canvapps';
          </text>
          <text fontSize="12" color="#ffffff">const price = signal(100);</text>
          <text fontSize="12" color="#ffffff">
            const tax = computed(() => price.value * 0.21);
          </text>
          <text fontSize="12" color="#ffffff">
            const total = computed(() => price.value + tax.value);
          </text>
          <text fontSize="12" color="#22c55e">
            {{ t.value.docs.codeComments.updateSignal }}
          </text>
          <text fontSize="12" color="#f8fafc">price.value = 150;</text>
        </view>
      </view>
    }

    <!-- ========================================================================= -->
    <!-- TAB 6: CLI & BUILDS                                                       -->
    <!-- ========================================================================= -->
    @if (activeTab.value === 'cli') {
      <view
        width="100%"
        maxWidth="1120"
        flexDirection="column"
        :padding={isMobile.value ? [16, 14] : [24, 28]}
        :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
        borderRadius="18"
        borderWidth="1"
        :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
        gap="18"
        flexShrink="0"
      >
        <view flexDirection="column" gap="4">
          <text
            fontSize="18"
            fontWeight="bold"
            :color={isDark.value ? '#38bdf8' : '#0284c7'}
          >
            {{ t.value.docs.cli.title }}
          </text>
          <text
            fontSize="13"
            :color={isDark.value ? '#94a3b8' : '#475569'}
            lineHeight="1.5"
          >
            {{ t.value.docs.cli.subtitle }}
          </text>
        </view>

        <!-- Commands Box -->
        <view
          flexDirection="column"
          padding="[16, 18]"
          :backgroundColor={isDark.value ? '#080c14' : '#0f172a'}
          borderRadius="12"
          borderWidth="1"
          borderColor="#1e293b"
          gap="10"
        >
          <text
            fontSize="12"
            fontWeight="bold"
            color="#38bdf8"
          >
            # {{ t.value.docs.cli.targetsTitle }} - SPA
          </text>
          <text
            fontSize="13"
            fontWeight="bold"
            color="#f8fafc"
          >
            canvapps build --target=spa
          </text>
          <text
            fontSize="12"
            fontWeight="bold"
            color="#38bdf8"
          >
            {{ t.value.docs.codeComments.buildPwa }}
          </text>
          <text
            fontSize="13"
            fontWeight="bold"
            color="#f8fafc"
          >
            canvapps build --target=pwa
          </text>
          <text
            fontSize="12"
            fontWeight="bold"
            color="#38bdf8"
          >
            # {{ t.value.docs.cli.targetsTitle }} - Capacitor (iOS / Android)
          </text>
          <text
            fontSize="13"
            fontWeight="bold"
            color="#22c55e"
          >
            canvapps build --target=capacitor
          </text>
        </view>
      </view>
    }

    <!-- Modal Blur Preview -->
    @if (isDocModalOpen.value) {
      <modal
        animation="scale-in"
        :blur="true"
        :duration="300"
        @close="closeDocModal"
      >
        <view
          :width={isMobile.value ? 300 : 380}
          :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
          borderRadius="20"
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
          :padding={isMobile.value ? [20, 18] : [26, 22]}
          flexDirection="column"
          alignItems="center"
          gap="14"
        >
          <text
            fontSize="18"
            fontWeight="bold"
            :color={isDark.value ? '#f1f5f9' : '#0f172a'}
          >
            {{ t.value.docs.components.demoModalTitle }}
          </text>
          <text
            fontSize="12"
            :color={isDark.value ? '#94a3b8' : '#64748b'}
            textAlign="center"
            lineHeight="1.4"
          >
            {{ t.value.docs.components.demoModalText }}
          </text>
          <button
            :label="t.value.docs.components.demoModalCloseBtn"
            backgroundColor="#0284c7"
            hoverBackgroundColor="#0369a1"
            labelColor="#ffffff"
            borderRadius="8"
            padding="[10, 20]"
            fontSize="13"
            fontWeight="bold"
            @click="closeDocModal"
          />
        </view>
      </modal>
    }

  </view>
</motion>
