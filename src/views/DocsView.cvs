<script lang="ts">
  import { sessionStore, navigateRoute } from '../stores/session.store';
  import { soundManager } from '../utils/sound';
  import { t } from '../i18n';

  // Responsive signals
  const { isMobile, isTablet, isDesktop } = useBreakpoints();
  const isDark = computed(() => sessionStore.state.theme === 'dark');

  // Active Documentation Section Tab
  const activeTab = signal<'quickstart' | 'components' | 'attributes' | 'layout' | 'signals' | 'cli'>('quickstart');

  // Interactive Live Playground state
  const demoCounter = signal(0);
  const compButtonCount = signal(0);
  const compSliderVal = signal(60);
  const isDocModalOpen = signal(false);

  function setDocTab(tab: 'quickstart' | 'components' | 'attributes' | 'layout' | 'signals' | 'cli') {
    soundManager.playClick(750);
    activeTab.value = tab;
  }

  function incrementDemo() {
    soundManager.playPop(520);
    demoCounter.update((n) => n + 1);
  }

  function resetDemo() {
    soundManager.playClick(400);
    demoCounter.value = 0;
  }

  function incrementCompBtn() {
    soundManager.playPop(600);
    compButtonCount.update((n) => n + 1);
  }

  function onCompSlider(e: any) {
    const val = Math.round(Number(e?.value ?? e?.target?.value ?? 0));
    compSliderVal.value = val;
    soundManager.playSliderTick(val);
  }

  function openDocModal() {
    soundManager.playSwoosh();
    isDocModalOpen.value = true;
  }

  function closeDocModal() {
    soundManager.playClick(500);
    isDocModalOpen.value = false;
  }
</script>

<motion
