<script lang="ts">
  import { sessionStore, navigateRoute } from '../stores/session.store';
  import { soundManager } from '../utils/sound';
  import { t } from '../i18n';

  // Responsive signals
  const { isMobile, isTablet, isDesktop } = useBreakpoints();
  const isDark = computed(() => sessionStore.state.theme === 'dark');

  // Active Documentation Section Tab
  const activeTab = signal<'quickstart' | 'components' | 'attributes' | 'layout' | 'signals' | 'cli'>('quickstart');

  // Interactive Live Playground state
  const demoCounter = signal(0);
  const compButtonCount = signal(0);
  const compSliderVal = signal(60);
  const isDocModalOpen = signal(false);

  const compSelectVal = signal('120fps');
  const selectOptions = [
    { label: '⚡ 120 FPS Ultra Retina', value: '120fps' },
    { label: '🚀 60 FPS Estándar', value: '60fps' },
    { label: '🔋 30 FPS Ahorro de Energía', value: '30fps' },
  ];

  function onCompSelectChange(e: any) {
    const val = e?.value ?? e?.target?.value ?? '120fps';
    compSelectVal.value = val;
    soundManager.playClick(650);
  }

  const eventLogText = signal('Interactúa con los botones o controles para inspeccionar eventos en tiempo real');
  const lastEventName = signal('@click');
  const eventClickCount = signal(0);
  const lastEventCoord = signal('x: 0, y: 0');
  const lastModifierKeys = signal('ninguna');

  function handleDemoClick(e: any) {
    soundManager.playPop(560);
    eventClickCount.update((n) => n + 1);
    lastEventName.value = '@click';
    const x = Math.round(e?.x ?? e?.clientX ?? 0);
    const y = Math.round(e?.y ?? e?.clientY ?? 0);
    lastEventCoord.value = `x: ${x}, y: ${y}`;
    const mods = [];
    if (e?.ctrlKey) mods.push('Ctrl');
    if (e?.shiftKey) mods.push('Shift');
    if (e?.altKey) mods.push('Alt');
    if (e?.metaKey) mods.push('Cmd/Meta');
    lastModifierKeys.value = mods.length > 0 ? mods.join('+') : 'ninguna';
    eventLogText.value = `@click disparado | Canvas (${x}, ${y}) | Botón: ${e?.button ?? 0} | Total: ${eventClickCount.value}`;
  }

  function handleDemoPointerDown(e: any) {
    soundManager.playClick(700);
    lastEventName.value = '@pointerdown';
    const x = Math.round(e?.x ?? e?.clientX ?? 0);
    const y = Math.round(e?.y ?? e?.clientY ?? 0);
    lastEventCoord.value = `x: ${x}, y: ${y}`;
    eventLogText.value = `@pointerdown presionado en (${x}, ${y}) con pointerType: ${e?.pointerType || 'mouse'}`;
  }

  function handleDemoHover(isEntering: boolean) {
    if (isEntering) {
      soundManager.playClick(900);
      lastEventName.value = '@pointerenter';
      eventLogText.value = '@pointerenter detectado: el cursor ingresó al área del elemento';
    } else {
      lastEventName.value = '@pointerleave';
      eventLogText.value = '@pointerleave detectado: el cursor salió del área del elemento';
    }
  }

  function handleDemoInput(e: any) {
    const val = e?.value ?? e?.target?.value ?? '';
    lastEventName.value = '@input';
    eventLogText.value = `@input emitido con valor reactivo: "${val}" (longitud: ${val.length})`;
  }

  function handleDemoSubmit(e: any) {
    soundManager.playSwoosh();
    const val = e?.value ?? e?.target?.value ?? '';
    lastEventName.value = '@submit';
    eventLogText.value = `@submit disparado al presionar Enter con valor: "${val}"`;
  }

  function setDocTab(tab: 'quickstart' | 'components' | 'attributes' | 'layout' | 'signals' | 'cli') {
    soundManager.playClick(750);
    activeTab.value = tab;
  }

  function incrementDemo() {
    soundManager.playPop(520);
    demoCounter.update((n) => n + 1);
  }

  function resetDemo() {
    soundManager.playClick(400);
    demoCounter.value = 0;
  }

  function incrementCompBtn() {
    soundManager.playPop(600);
    compButtonCount.update((n) => n + 1);
  }

  function onCompSlider(e: any) {
    const val = Math.round(Number(e?.value ?? e?.target?.value ?? 0));
    compSliderVal.value = val;
    soundManager.playSliderTick(val);
  }

  function openDocModal() {
    soundManager.playSwoosh();
    isDocModalOpen.value = true;
  }

  function closeDocModal() {
    soundManager.playClick(500);
    isDocModalOpen.value = false;
  }
</script>

<motion
