                <view
                  width="100%"
                  flexDirection="row"
                  alignItems="center"
                  justifyContent="space-between"
                >
                  <view
                    flexDirection="row"
                    alignItems="center"
                    gap="6"
                  >
                    <view
                      width="20"
                      height="20"
                      :backgroundColor="item.avatarColor"
                      borderRadius="10"
                      alignItems="center"
                      justifyContent="center"
                    >
                      <text
                        fontSize="10"
                        fontWeight="bold"
                        color="#ffffff"
                      >
                        {{ item.author.charAt(0) }}
                      </text>
                    </view>
                    <text
                      fontSize="11"
                      :color={isDark.value ? '#94a3b8' : '#64748b'}
                    >
                      {{ item.author }}
                    </text>
                  </view>
                  <button
                    :label={item.isLiked ? '♥ ' + item.likes : '♡ ' + item.likes}
                    :color={item.isLiked ? '#ff4d6d' : (isDark.value ? '#94a3b8' : '#64748b')}
                    backgroundColor="transparent"
                    fontSize="11"
                    @click="toggleLikeItem(item, $event)"
                  />
                </view>
              </view>
            </view>
          }
        </view>
      }

      <!-- Column 4 (Wide Screen) -->
      @if (columnCount.value >= 5) {
        <view
          :width="colWidth.value"
          flexDirection="column"
          :gap={isMobile.value ? 10 : 16}
          flexShrink="0"
        >
          @each col4.value as item {
            <view
              width="100%"
              flexDirection="column"
              :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
              borderRadius="16"
              overflow="hidden"
              borderWidth="1"
              :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
              flexShrink="0"
              @click="handleItemClick(item, $event)"
            >
              <view
                width="100%"
                position="relative"
                flexShrink="0"
              >
                <image
                  :src="item.src"
                  width="100%"
                  :height="item.height"
                  fit="cover"
                  borderRadius="[16, 16, 0, 0]"
                  :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
                />
                <view
                  position="absolute"
                  right="8"
                  top="8"
                >
                  <button
                    :label={item.isSaved ? 'Saved ✓' : 'Save'}
                    :backgroundColor={item.isSaved ? (isDark.value ? '#1e293b' : '#e2e8f0') : '#0284c7'}
                    :color={item.isSaved ? (isDark.value ? '#ffffff' : '#334155') : '#ffffff'}
                    borderRadius="14"
                    padding="[4, 10]"
                    fontSize="11"
                    fontWeight="bold"
                    @click="toggleSaveItem(item, $event)"
                  />
                </view>
              </view>
              <view
                width="100%"
                padding="[10, 12]"
                flexDirection="column"
                gap="6"
                flexShrink="0"
              >
                <text
                  fontSize="14"
                  fontWeight="bold"
                  :color={isDark.value ? '#f1f5f9' : '#0f172a'}
                  textOverflow="ellipsis"
                >
                  {{ item.title }}
                </text>
                <view
                  width="100%"
                  flexDirection="row"
                  alignItems="center"
                  justifyContent="space-between"
                >
                  <view
                    flexDirection="row"
                    alignItems="center"
                    gap="6"
                  >
                    <view
                      width="20"
                      height="20"
                      :backgroundColor="item.avatarColor"
                      borderRadius="10"
                      alignItems="center"
                      justifyContent="center"
                    >
                      <text
                        fontSize="10"
                        fontWeight="bold"
                        color="#ffffff"
                      >
                        {{ item.author.charAt(0) }}
                      </text>
                    </view>
                    <text
                      fontSize="11"
                      :color={isDark.value ? '#94a3b8' : '#64748b'}
                    >
                      {{ item.author }}
                    </text>
                  </view>
                  <button
                    :label={item.isLiked ? '♥ ' + item.likes : '♡ ' + item.likes}
                    :color={item.isLiked ? '#ff4d6d' : (isDark.value ? '#94a3b8' : '#64748b')}
                    backgroundColor="transparent"
                    fontSize="11"
                    @click="toggleLikeItem(item, $event)"
                  />
                </view>
              </view>
            </view>
          }
        </view>
      }

    </view>

    <!-- 4. Interactive Fullscreen Lightbox Modal -->
    <modal
      :open="isModalOpen.value"
      :originRect="modalOriginRect.value"
      animation="hero"
      :duration="340"
      @close="closeModal"
    >
      @if (selectedItem.value) {
        <view
          :width={isMobile.value ? '92%' : 780}
          :flexDirection={isMobile.value ? 'column' : 'row'}
          :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
          borderRadius="24"
          overflow="hidden"
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
          :boxShadow={isDark.value ? { offsetX: 0, offsetY: 20, blur: 50, color: 'rgba(0,0,0,0.85)' } : { offsetX: 0, offsetY: 20, blur: 50, color: 'rgba(0,0,0,0.18)' }}
        >

          <!-- Left: Large Image View -->
          <view
            :width={isMobile.value ? '100%' : 400}
            :height={isMobile.value ? 220 : 480}
            :backgroundColor={isDark.value ? '#080c14' : '#f1f5f9'}
            flexShrink="0"
          >
            <image
              :src="selectedItem.value?.src"
              width="100%"
              height="100%"
              fit="cover"
            />
          </view>

          <!-- Right: Details & Actions -->
          <view
            :width={isMobile.value ? '100%' : 380}
            flexGrow="1"
            flexDirection="column"
            :padding={isMobile.value ? [12, 14] : [20, 24]}
            :gap={isMobile.value ? 10 : 16}
            flexShrink="0"
          >

            <!-- Top Row: Close & Save Action -->
            <view
              width="100%"
              flexDirection="row"
              justifyContent="space-between"
              alignItems="center"
              flexShrink="0"
            >
              <button
                :label="t.value.gallery.closeButton"
                :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
                :color={isDark.value ? '#94a3b8' : '#475569'}
                borderRadius="16"
                padding="[6, 12]"
                fontSize="12"
                @click="closeModal"
              />
              <button
                :label="selectedItem.value?.isSaved ? t.value.gallery.savedButton : t.value.gallery.saveButton"
                :backgroundColor={selectedItem.value?.isSaved ? (isDark.value ? '#1e293b' : '#e2e8f0') : '#0284c7'}
                :color={selectedItem.value?.isSaved ? (isDark.value ? '#ffffff' : '#334155') : '#ffffff'}
                borderRadius="18"
                padding="[6, 16]"
                fontSize="12"
                fontWeight="bold"
                @click="toggleSaveItem(selectedItem.value!, $event)"
              />
            </view>

            <!-- Item Content Info -->
            <view
              width="100%"
              flexDirection="column"
              gap="6"
              flexShrink="0"
            >
              <text
                :fontSize={isMobile.value ? 16 : 22}
                fontWeight="bold"
                :color={isDark.value ? '#ffffff' : '#0f172a'}
                :wordWrap="true"
              >
                {{ selectedItem.value?.title }}
              </text>
              <text
                :fontSize={isMobile.value ? 12 : 13}
                :color={isDark.value ? '#94a3b8' : '#475569'}
                :lineHeight="18"
                :wordWrap="true"
              >
                {{ selectedItem.value?.description }}
              </text>
            </view>

            <!-- Author Info & Follow Action Card -->
            <view
              width="100%"
              flexDirection="row"
              alignItems="center"
              justifyContent="space-between"
              :padding={isMobile.value ? [8, 10] : [10, 12]}
              borderRadius="16"
              :backgroundColor={isDark.value ? '#162032' : '#f8fafc'}
              borderWidth="1"
              :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
              flexShrink="0"
            >
              <view
                flexDirection="row"
                alignItems="center"
                gap="10"
              >
                <view
                  width="36"
                  height="36"
                  :backgroundColor={selectedItem.value?.avatarColor || '#e11d48'}
                  borderRadius="18"
                  alignItems="center"
                  justifyContent="center"
                >
                  <text
                    fontSize="14"
                    fontWeight="bold"
                    color="#ffffff"
                  >
                    {{ (selectedItem.value?.author || 'A').charAt(0) }}
                  </text>
                </view>
                <view flexDirection="column" gap="1">
                  <text
                    fontSize="13"
                    fontWeight="bold"
                    :color={isDark.value ? '#ffffff' : '#0f172a'}
                  >
                    {{ selectedItem.value?.author }}
                  </text>
                  <text
                    fontSize="10"
                    :color={isDark.value ? '#94a3b8' : '#64748b'}
                  >
                    {{ selectedItem.value?.authorHandle }}
                  </text>
                </view>
              </view>
              <button
                label="Follow"
                :backgroundColor={isDark.value ? '#1e293b' : '#e2e8f0'}
                :color={isDark.value ? '#f1f5f9' : '#1e293b'}
                borderRadius="14"
                padding="[6, 14]"
                fontSize="11"
                fontWeight="bold"
              />
            </view>

            <!-- Footer Stats & Tags -->
            <view
              width="100%"
              flexDirection="row"
              alignItems="center"
              justifyContent="space-between"
              flexShrink="0"
            >
              <button
                :label={selectedItem.value?.isLiked ? '♥ Liked (' + (selectedItem.value?.likes || 0) + ')' : '♡ Like (' + (selectedItem.value?.likes || 0) + ')'}
                :color={selectedItem.value?.isLiked ? '#ff4d6d' : (isDark.value ? '#ffffff' : '#1e293b')}
                :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
                borderRadius="14"
                padding="[4, 12]"
                fontSize="11"
                @click="toggleLikeItem(selectedItem.value!, $event)"
              />
              <text fontSize="11" :color={isDark.value ? '#64748b' : '#94a3b8'}>
                {{ t.value.gallery.categoryLabel }}: {{ selectedItem.value?.category }}
              </text>
            </view>

          </view>

        </view>
      }
    </modal>

  </view>
</motion>
