        </view>
      </view>

    </view>

    <!-- 2. Category Filter Pills Bar (Horizontal Chips Carousel) -->
    <view
      width="100%"
      flexDirection="row"
      gap="8"
      overflow="auto"
      padding="[2, 0]"
      flexShrink="0"
    >
      @each categories as cat {
