                  :src="item.src"
                  width="100%"
                  :height="item.height"
                  fit="cover"
                  borderRadius="[16, 16, 0, 0]"
                  :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
                />
                <view
