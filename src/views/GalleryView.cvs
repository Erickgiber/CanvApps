<script lang="ts">
  import { sessionStore, navigateRoute } from '../stores/session.store';
  import { galleryData, GalleryItem, toggleSaveGalleryItem, toggleLikeGalleryItem, saveGalleryScroll, restoreGalleryScroll, galleryScrollPosition, resetScrollToTop, activeCategory, searchQuery, categories } from '../stores/gallery.store';
  import { soundManager } from '../utils/sound';
  import { t } from '../i18n';

  const isDark = computed(() => sessionStore.state.theme === 'dark');

  // 1. Responsive Viewport Signals (First-Mobile Architecture)
  const { isMobile, isTablet, isDesktop, width } = useBreakpoints();

  function goTo(route: string) {
    soundManager.playClick();
    navigateRoute(route);
  }

  // Responsive Column Count
  const columnCount = computed(() => {
      if (isMobile.value) return 2;
      if (isTablet.value) return 3;
      return 4;
    });

  // 2. State Signals
  const isModalOpen = signal(false);
  const selectedItem = signal<GalleryItem | null>(null);

  // 3. Reactive Filtered Data
  const filteredItems = computed(() => {
      const cat = activeCategory.value;
      const q = searchQuery.value.trim().toLowerCase();

      return galleryData.value.filter((item) => {
          const matchCat = cat === 'All' || item.category === cat;
          const matchSearch =
          !q ||
          item.title.toLowerCase().includes(q) ||
          item.author.toLowerCase().includes(q) ||
          item.tags.some((t) => t.toLowerCase().includes(q));
          return matchCat && matchSearch;
        });
    });

  // 4. True Greedy Shortest-Column Masonry Algorithm
  const columns = computed(() => {
      const count = columnCount.value;
      const cols: GalleryItem[][] = Array.from({ length: count }, () => []);
      const heights = Array.from({ length: count }, () => 0);

      filteredItems.value.forEach((item) => {
          let minCol = 0;
          for (let i = 1; i < count; i++) {
            if (heights[i] < heights[minCol]) {
              minCol = i;
            }
          }
          cols[minCol].push(item);
          heights[minCol] += (item.height || 220) + 60;
        });

      return cols;
    });

  const col0 = computed(() => columns.value[0] || []);
  const col1 = computed(() => columns.value[1] || []);
  const col2 = computed(() => columns.value[2] || []);
  const col3 = computed(() => columns.value[3] || []);
  const col4 = computed(() => columns.value[4] || []);

  const colWidth = computed(() => isMobile.value ? '48.5%' : columnCount.value === 3 ? '32%' : '23.8%');

  // 5. User Interaction Handlers
  function selectCategory(cat: string) {
    soundManager.playClick(650);
    activeCategory.value = cat;
  }

  function onSearchChange(val: string) {
    searchQuery.value = val;
  }

  function toggleSaveItem(item: GalleryItem, e?: any) {
    soundManager.playChime();
    toggleSaveGalleryItem(item, e);
    if (selectedItem.value && selectedItem.value.id === item.id) {
      selectedItem.value = { ...selectedItem.value, isSaved: item.isSaved };
    }
  }

  function toggleLikeItem(item: GalleryItem, e?: any) {
    soundManager.playPop(580);
    toggleLikeGalleryItem(item, e);
    if (selectedItem.value && selectedItem.value.id === item.id) {
      selectedItem.value = { ...selectedItem.value, likes: item.likes, isLiked: item.isLiked };
    }
  }

  function handleItemClick(item: GalleryItem, e?: any) {
    soundManager.playClick(800);
    if (isMobile.value) {
      saveGalleryScroll();
      resetScrollToTop();
      navigateRoute('/gallery/' + item.id);
    } else {
      openModal(item, e);
    }
  }

  // Restore previous scroll position on mobile return
  if (typeof window !== 'undefined') {
    queueMicrotask(() => {
        if (galleryScrollPosition.value > 0) {
          restoreGalleryScroll();
        }
      });
  }

  const modalOriginRect = signal<{ x: number; y: number; width: number; height: number } | null>(null);

  function openModal(item: GalleryItem, e?: any) {
    selectedItem.value = item;
    let rect: { x: number; y: number; width: number; height: number } | null = null;
    const target = e?.target;
    const currentTarget = e?.currentTarget;
    const el = (currentTarget && currentTarget.worldRect && currentTarget.worldRect.width > 0)
    ? currentTarget
    : (target && target.worldRect && target.worldRect.width > 0)
    ? target
    : null;

    if (el && el.worldRect && el.worldRect.width > 0) {
      rect = {
        x: el.worldRect.x,
        y: el.worldRect.y,
        width: el.worldRect.width,
        height: el.worldRect.height,
      };
    } else if (e && typeof e.x === 'number' && typeof e.y === 'number') {
      const w = 240;
      const h = item.height || 260;
      rect = {
        x: Math.max(0, e.x - w / 2),
        y: Math.max(0, e.y - h / 2),
        width: w,
        height: h,
      };
    }
    modalOriginRect.value = rect;
    isModalOpen.value = true;
  }

  function closeModal() {
    isModalOpen.value = false;
  }
</script>

<!-- Visual Gallery Canvas View Container -->
<motion
  display="flex"
  flexDirection="column"
  width="100%"
  alignItems="center"
  animation="scale-in"
  :duration="450"
>
  <view
    width="100%"
    maxWidth="1120"
    flexDirection="column"
    :padding={isMobile.value ? [4, 4] : [0, 4]}
    :gap={isMobile.value ? 10 : 12}
    flexShrink="0"
  >

    <!-- 1. Top Header Row: Left Back Button + Brand, Right Search Bar (Aligned with Global Top Bar) -->
    <view
      width="100%"
      :flexDirection={isMobile.value ? 'column' : 'row'}
      :alignItems={isMobile.value ? 'stretch' : 'center'}
      justifyContent="space-between"
      :gap={isMobile.value ? 8 : 12}
      padding="[2, 0]"
      flexShrink="0"
    >

      <!-- Left Section: Title & Brand Badge -->
      <view
        flexDirection="row"
        alignItems="center"
        gap="10"
        flexShrink="0"
      >
        <view
          flexDirection="row"
          alignItems="baseline"
          gap="8"
        >
          <text
            :fontSize={isMobile.value ? 16 : 18}
            fontWeight="bold"
            :color={isDark.value ? '#ffffff' : '#0f172a'}
          >
            🎨 {{ t.value.gallery.title }}
          </text>
        </view>
      </view>

      <!-- Right Section: Search Input Bar -->
      <view
        flexDirection="row"
        alignItems="center"
        gap="8"
        :width={isMobile.value ? '100%' : 'auto'}
        flexShrink="0"
      >
        <view
          :width={isMobile.value ? '100%' : '260'}
          height="34"
          :backgroundColor={isDark.value ? '#162032' : '#ffffff'}
          borderRadius="17"
          padding="[0, 12]"
          flexDirection="row"
          alignItems="center"
          gap="6"
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#cbd5e1'}
          flexShrink="0"
        >
          <text fontSize="13" :color={isDark.value ? '#94a3b8' : '#64748b'}>
            🔍
          </text>
          <input
            width="100%"
            height="28"
            backgroundColor="transparent"
            borderWidth="0"
            borderColor="transparent"
            focusBorderColor="transparent"
            :color={isDark.value ? '#f1f5f9' : '#0f172a'}
            :placeholderColor={isDark.value ? '#64748b' : '#94a3b8'}
            fontSize="12"
            :placeholder="t.value.gallery.searchPlaceholder"
            :value="searchQuery.value"
