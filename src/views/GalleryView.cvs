          :backgroundColor={activeCategory.value === cat ? '#0284c7' : (isDark.value ? '#162032' : '#f1f5f9')}
          :color={activeCategory.value === cat ? '#ffffff' : (isDark.value ? '#94a3b8' : '#475569')}
          borderRadius="20"
          padding="[6, 14]"
          fontSize="13"
          :fontWeight={activeCategory.value === cat ? 'bold' : 'normal'}
          :borderWidth={activeCategory.value === cat ? 0 : 1}
          :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
          flexShrink="0"
          @click="selectCategory(cat)"
        />
      }
    </view>

    <!-- 3. Responsive Masonry Multi-Column Grid -->
    <view
      width="100%"
      flexDirection="row"
      :gap={isMobile.value ? 10 : 16}
      alignItems="flex-start"
      flexShrink="0"
    >

      <!-- Column 0 -->
      <view
        :width="colWidth.value"
        flexDirection="column"
        :gap={isMobile.value ? 10 : 16}
        flexShrink="0"
      >
        @each col0.value as item {
          <view
            width="100%"
            flexDirection="column"
            :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
            borderRadius="16"
            overflow="hidden"
            borderWidth="1"
            :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
            flexShrink="0"
            @click="handleItemClick(item, $event)"
          >
            <view
              width="100%"
              position="relative"
              flexShrink="0"
            >
              <image
                :src="item.src"
                width="100%"
                :height="item.height"
                fit="cover"
                borderRadius="[16, 16, 0, 0]"
                :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
              />
              <view
                position="absolute"
                right="8"
                top="8"
              >
                <button
                  :label={item.isSaved ? 'Saved ✓' : 'Save'}
                  :backgroundColor={item.isSaved ? (isDark.value ? '#1e293b' : '#e2e8f0') : '#0284c7'}
                  :color={item.isSaved ? (isDark.value ? '#ffffff' : '#334155') : '#ffffff'}
                  borderRadius="14"
                  padding="[4, 10]"
                  fontSize="11"
                  fontWeight="bold"
                  @click="toggleSaveItem(item, $event)"
                />
              </view>
            </view>
            <view
              width="100%"
              padding="[10, 12]"
              flexDirection="column"
              gap="6"
              flexShrink="0"
            >
              <text
                fontSize="14"
                fontWeight="bold"
                :color={isDark.value ? '#f1f5f9' : '#0f172a'}
                textOverflow="ellipsis"
              >
                {{ item.title }}
              </text>
              <view
                width="100%"
                flexDirection="row"
                alignItems="center"
                justifyContent="space-between"
              >
                <view
                  flexDirection="row"
                  alignItems="center"
                  gap="6"
                >
                  <view
                    width="20"
                    height="20"
                    :backgroundColor="item.avatarColor"
                    borderRadius="10"
                    alignItems="center"
                    justifyContent="center"
                  >
                    <text
                      fontSize="10"
                      fontWeight="bold"
                      color="#ffffff"
                    >
                      {{ item.author.charAt(0) }}
                    </text>
                  </view>
                  <text
                    fontSize="11"
                    :color={isDark.value ? '#94a3b8' : '#64748b'}
                  >
                    {{ item.author }}
                  </text>
                </view>
                <button
                  :label={item.isLiked ? '♥ ' + item.likes : '♡ ' + item.likes}
                  :color={item.isLiked ? '#ff4d6d' : (isDark.value ? '#94a3b8' : '#64748b')}
                  backgroundColor="transparent"
                  fontSize="11"
                  @click="toggleLikeItem(item, $event)"
                />
              </view>
            </view>
          </view>
        }
      </view>

      <!-- Column 1 -->
      <view
        :width="colWidth.value"
        flexDirection="column"
        :gap={isMobile.value ? 10 : 16}
        flexShrink="0"
      >
        @each col1.value as item {
          <view
            width="100%"
            flexDirection="column"
            :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
            borderRadius="16"
            overflow="hidden"
            borderWidth="1"
            :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
            flexShrink="0"
            @click="handleItemClick(item, $event)"
          >
            <view
              width="100%"
              position="relative"
              flexShrink="0"
            >
              <image
                :src="item.src"
                width="100%"
                :height="item.height"
                fit="cover"
                borderRadius="[16, 16, 0, 0]"
                :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
              />
              <view
                position="absolute"
                right="8"
                top="8"
              >
                <button
                  :label={item.isSaved ? 'Saved ✓' : 'Save'}
                  :backgroundColor={item.isSaved ? (isDark.value ? '#1e293b' : '#e2e8f0') : '#0284c7'}
                  :color={item.isSaved ? (isDark.value ? '#ffffff' : '#334155') : '#ffffff'}
                  borderRadius="14"
                  padding="[4, 10]"
                  fontSize="11"
                  fontWeight="bold"
                  @click="toggleSaveItem(item, $event)"
                />
              </view>
            </view>
            <view
              width="100%"
              padding="[10, 12]"
              flexDirection="column"
              gap="6"
              flexShrink="0"
            >
              <text
                fontSize="14"
                fontWeight="bold"
                :color={isDark.value ? '#f1f5f9' : '#0f172a'}
                textOverflow="ellipsis"
              >
                {{ item.title }}
              </text>
              <view
                width="100%"
                flexDirection="row"
                alignItems="center"
                justifyContent="space-between"
              >
                <view
                  flexDirection="row"
                  alignItems="center"
                  gap="6"
                >
                  <view
                    width="20"
                    height="20"
                    :backgroundColor="item.avatarColor"
                    borderRadius="10"
                    alignItems="center"
                    justifyContent="center"
                  >
                    <text
                      fontSize="10"
                      fontWeight="bold"
                      color="#ffffff"
                    >
                      {{ item.author.charAt(0) }}
                    </text>
                  </view>
                  <text
                    fontSize="11"
                    :color={isDark.value ? '#94a3b8' : '#64748b'}
                  >
                    {{ item.author }}
                  </text>
                </view>
                <button
                  :label={item.isLiked ? '♥ ' + item.likes : '♡ ' + item.likes}
                  :color={item.isLiked ? '#ff4d6d' : (isDark.value ? '#94a3b8' : '#64748b')}
                  backgroundColor="transparent"
                  fontSize="11"
                  @click="toggleLikeItem(item, $event)"
                />
              </view>
            </view>
          </view>
        }
      </view>

      <!-- Column 2 (Tablet / Desktop) -->
      @if (columnCount.value >= 3) {
        <view
          :width="colWidth.value"
          flexDirection="column"
          :gap={isMobile.value ? 10 : 16}
          flexShrink="0"
        >
          @each col2.value as item {
            <view
              width="100%"
              flexDirection="column"
              :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
              borderRadius="16"
              overflow="hidden"
              borderWidth="1"
              :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
              flexShrink="0"
              @click="handleItemClick(item, $event)"
            >
              <view
                width="100%"
                position="relative"
                flexShrink="0"
              >
                <image
                  :src="item.src"
                  width="100%"
                  :height="item.height"
                  fit="cover"
                  borderRadius="[16, 16, 0, 0]"
                  :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
                />
                <view
                  position="absolute"
                  right="8"
                  top="8"
                >
                  <button
                    :label={item.isSaved ? 'Saved ✓' : 'Save'}
                    :backgroundColor={item.isSaved ? (isDark.value ? '#1e293b' : '#e2e8f0') : '#0284c7'}
                    :color={item.isSaved ? (isDark.value ? '#ffffff' : '#334155') : '#ffffff'}
                    borderRadius="14"
                    padding="[4, 10]"
                    fontSize="11"
                    fontWeight="bold"
                    @click="toggleSaveItem(item, $event)"
                  />
                </view>
              </view>
              <view
                width="100%"
                padding="[10, 12]"
                flexDirection="column"
                gap="6"
                flexShrink="0"
              >
                <text
                  fontSize="14"
                  fontWeight="bold"
                  :color={isDark.value ? '#f1f5f9' : '#0f172a'}
                  textOverflow="ellipsis"
                >
                  {{ item.title }}
                </text>
                <view
                  width="100%"
                  flexDirection="row"
                  alignItems="center"
                  justifyContent="space-between"
                >
                  <view
                    flexDirection="row"
                    alignItems="center"
                    gap="6"
                  >
                    <view
                      width="20"
                      height="20"
                      :backgroundColor="item.avatarColor"
                      borderRadius="10"
                      alignItems="center"
                      justifyContent="center"
                    >
                      <text
                        fontSize="10"
                        fontWeight="bold"
                        color="#ffffff"
                      >
                        {{ item.author.charAt(0) }}
                      </text>
                    </view>
                    <text
                      fontSize="11"
                      :color={isDark.value ? '#94a3b8' : '#64748b'}
                    >
                      {{ item.author }}
                    </text>
                  </view>
                  <button
                    :label={item.isLiked ? '♥ ' + item.likes : '♡ ' + item.likes}
                    :color={item.isLiked ? '#ff4d6d' : (isDark.value ? '#94a3b8' : '#64748b')}
                    backgroundColor="transparent"
                    fontSize="11"
                    @click="toggleLikeItem(item, $event)"
                  />
                </view>
              </view>
            </view>
          }
        </view>
      }

      <!-- Column 3 (Desktop) -->
      @if (columnCount.value >= 4) {
        <view
          :width="colWidth.value"
          flexDirection="column"
          :gap={isMobile.value ? 10 : 16}
          flexShrink="0"
        >
          @each col3.value as item {
            <view
              width="100%"
              flexDirection="column"
              :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
              borderRadius="16"
              overflow="hidden"
              borderWidth="1"
              :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
              flexShrink="0"
              @click="handleItemClick(item, $event)"
            >
              <view
                width="100%"
                position="relative"
                flexShrink="0"
