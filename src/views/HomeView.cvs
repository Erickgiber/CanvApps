<script lang="ts">
  import { sessionStore, toggleTheme, toggleGlobalSound, navigateRoute } from '../stores/session.store';
  import { soundManager } from '../utils/sound';
  import { t } from '../i18n';

  // Responsive viewport signals
  const { isMobile, isTablet, isDesktop } = useBreakpoints();
  const isDark = computed(() => sessionStore.state.theme === 'dark');
  const isSoundOn = computed(() => sessionStore.state.isSoundEnabled);

  // Interactive Basketball Mini-Game Signals & LocalStorage Persistence
  const initialHighScore = typeof window !== 'undefined' ? Number(localStorage.getItem('canvapps_basketball_highscore') ?? '0') : 0;

  const basketballScore = signal(0);
  const highScore = signal(initialHighScore);
  const timeLeft = signal(10);
  const gameState = signal<'idle' | 'playing' | 'gameover' | 'victory'>('idle');
  const isCopied = signal(false);
  let gameTimer: any = null;

  const targetGoal = computed(() => Math.max(20, highScore.value > 0 ? highScore.value : 20));

  // Real-time FPS Meter Signal
  const currentFps = signal(120);
  const frameTimeMs = signal(8.33);

  // Performance loop for real-time FPS calculation
  if (typeof window !== 'undefined') {
    let lastTime = performance.now();
    let frameCount = 0;
    let fpsTimer = performance.now();

    const measureFps = (now: number) => {
      frameCount++;
      const delta = now - lastTime;
      lastTime = now;

      if (now - fpsTimer >= 350) {
        const measuredFps = Math.round((frameCount * 1000) / (now - fpsTimer));
        currentFps.value = Math.min(144, Math.max(30, measuredFps));
        frameTimeMs.value = Number((1000 / currentFps.value).toFixed(2));
        frameCount = 0;
        fpsTimer = now;
      }
      requestAnimationFrame(measureFps);
    };
    requestAnimationFrame(measureFps);
  }

  // Mini-Game Continuous Actions
  function startGame() {
    if (gameTimer) clearInterval(gameTimer);
    basketballScore.value = 0;
    timeLeft.value = 10;
    gameState.value = 'playing';

    gameTimer = setInterval(() => {
        if (timeLeft.value > 0 && gameState.value === 'playing') {
          timeLeft.update((t) => t - 1);
          if (timeLeft.value === 0) {
            clearInterval(gameTimer);
            gameTimer = null;
            if (basketballScore.value >= targetGoal.value) {
              gameState.value = 'victory';
              soundManager.playChime();
            } else {
              gameState.value = 'gameover';
              soundManager.playPop(300);
            }
          }
        }
      }, 1000);
  }

  function resetGame() {
    if (gameTimer) {
      clearInterval(gameTimer);
      gameTimer = null;
    }
    basketballScore.value = 0;
    timeLeft.value = 30;
    gameState.value = 'idle';
  }

  function launchBasketball(e: any) {
    if (gameState.value !== 'playing') {
      startGame();
    }

    soundManager.playPop(480);
    const startX = e?.clientX ?? e?.x ?? (typeof window !== 'undefined' ? window.innerWidth / 2 - 100 : 200);
    const startY = e?.clientY ?? e?.y ?? (typeof window !== 'undefined' ? window.innerHeight / 2 : 200);
    const duration = 650;

    KineticFX.flyToken({
        from: { x: startX, y: startY },
        to: '#basketball-hoop',
        text: '🏀',
        color: '#f97316',
        backgroundColor: '#ea580c',
        borderColor: '#fed7aa',
        duration,
        onHit: () => {
          basketballScore.update((n) => n + 2);
          if (basketballScore.value > highScore.value) {
            highScore.value = basketballScore.value;
            if (typeof window !== 'undefined') {
              localStorage.setItem('canvapps_basketball_highscore', String(basketballScore.value));
            }
          }
          soundManager.playChime();
        },
      });
  }

  function copyInstallCommand() {
    soundManager.playChime();
    if (typeof navigator !== 'undefined' && navigator.clipboard) {
      navigator.clipboard.writeText('npm create canvapps@latest my-app').catch(() => {});
    }
    isCopied.value = true;
    setTimeout(() => {
        isCopied.value = false;
      }, 2200);
  }

  function handleThemeToggle() {
    toggleTheme();
  }

  function handleSoundToggle() {
    toggleGlobalSound();
  }
</script>

<view
  width="100%"
  flexDirection="column"
  alignItems="center"
  gap="30"
>

