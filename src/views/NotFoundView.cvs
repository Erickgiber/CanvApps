<script lang="ts">
  import { sessionStore, navigateRoute } from '../stores/session.store';
  import { t } from '../i18n';

  // Responsive signals
  const { isMobile } = useBreakpoints();
  const isDark = computed(() => sessionStore.state.theme === 'dark');

  function goHome() {
    navigateRoute('/');
  }

  function goGallery() {
    navigateRoute('/gallery');
  }

  function goProfile() {
    navigateRoute('/profile');
  }
</script>

<motion
  display="flex"
  flexDirection="column"
  width="100%"
  alignItems="center"
  animation="scale-in"
  :duration="400"
>
  <view
    width="100%"
    flexDirection="column"
    alignItems="center"
    justifyContent="center"
    :padding={isMobile.value ? [20, 16] : [40, 24]}
    flexGrow="1"
  >

    <!-- 404 Master Card -->
    <view
      :width={isMobile.value ? '100%' : 640}
      flexDirection="column"
      alignItems="center"
      :padding={isMobile.value ? [24, 18] : [36, 32]}
      borderRadius="24"
      borderWidth="1"
      :backgroundColor={isDark.value ? '#0d131f' : '#ffffff'}
      :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
      :boxShadow={isDark.value ? { offsetX: 0, offsetY: 20, blur: 50, color: 'rgba(0,0,0,0.85)' } : { offsetX: 0, offsetY: 20, blur: 50, color: 'rgba(0,0,0,0.08)' }}
      :gap={isMobile.value ? 16 : 24}
      flexShrink="0"
    >

      <!-- Glowing 404 Badge Icon -->
      <view
        width="72"
        height="72"
        borderRadius="36"
        :backgroundColor={isDark.value ? '#162032' : '#f0f9ff'}
        borderWidth="1"
        :borderColor={isDark.value ? '#1e293b' : '#bae6fd'}
        alignItems="center"
        justifyContent="center"
        flexShrink="0"
      >
        <text :fontSize={isMobile.value ? 28 : 34}>🛰️</text>
      </view>

      <!-- 404 Main Typography -->
      <view
        flexDirection="column"
        alignItems="center"
        gap="8"
        flexShrink="0"
      >
        <text
          fontSize="48"
          fontWeight="bold"
          color="#0284c7"
          letterSpacing="2"
        >
          404
        </text>
        <text
          :fontSize={isMobile.value ? 18 : 22}
          fontWeight="bold"
          :color={isDark.value ? '#ffffff' : '#0f172a'}
        >
          {{ t.value.notFound.title }}
        </text>
        <text
          :fontSize={isMobile.value ? 12 : 14}
          :color={isDark.value ? '#94a3b8' : '#64748b'}
          textAlign="center"
          :wordWrap="true"
        >
          {{ t.value.notFound.subtitle }}
        </text>
      </view>

      <!-- Current Route Info Pill -->
      <view
        :padding={isMobile.value ? [6, 12] : [8, 16]}
        borderRadius="12"
        :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
        borderWidth="1"
        :borderColor={isDark.value ? '#1e293b' : '#e2e8f0'}
        flexDirection="row"
        alignItems="center"
        gap="8"
        flexShrink="0"
      >
        <text fontSize="12" :color={isDark.value ? '#94a3b8' : '#64748b'}>
          {{ t.value.notFound.targetUrl }}:
        </text>
        <text
          fontSize="12"
          fontWeight="bold"
          color="#0284c7"
        >
          {{ sessionStore.state.activeRoute }}
        </text>
      </view>

      <!-- Action Navigation Buttons -->
      <view
        width="100%"
        :flexDirection={isMobile.value ? 'column' : 'row'}
        alignItems="center"
        justifyContent="center"
        :gap={isMobile.value ? 10 : 14}
        flexShrink="0"
      >

        <!-- 1. Home Dashboard Button -->
        <a
          href="/"
          :label="t.value.notFound.homeButton"
          backgroundColor="#0284c7"
          hoverBackgroundColor="#0369a1"
          color="#ffffff"
          borderRadius="14"
          :padding={isMobile.value ? [10, 16] : [10, 20]}
          fontSize="13"
          fontWeight="bold"
          underline="never"
        />

        <!-- 2. Gallery Button -->
        <a
          href="/showcases"
          :label="t.value.notFound.showcasesButton"
          :backgroundColor={isDark.value ? '#162032' : '#f1f5f9'}
          :hoverBackgroundColor={isDark.value ? '#1e293b' : '#e2e8f0'}
          :color={isDark.value ? '#38bdf8' : '#0284c7'}
          borderWidth="1"
          :borderColor={isDark.value ? '#1e293b' : '#cbd5e1'}
